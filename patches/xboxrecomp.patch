+/* ============================================================================
+ * Suspending a thread that is inside a guest lock
+ *
+ * A guest NtSuspendThread lands wherever the target is. On the console that
+ * is nearly always a sleep: the caller has the one CPU, and a thread is
+ * preempted inside a short locked region only rarely. Here the target runs
+ * beside the caller and can be anywhere, including inside
+ * RtlEnterCriticalSection. Windows' critical section wakes one waiter when the
+ * lock is released and wakes no other until that one has retried; suspended,
+ * it never does, and the lock -- free -- is never taken again. PGR2 (NOTES 17)
+ * suspends its audio meter thread at the end of a race, and that thread polls
+ * DirectSound every 2 ms: caught waiting on DirectSound's lock, it froze the
+ * main thread's teardown on the same lock, every few race ends.
+ *
+ * So each thread counts the guest locks it holds or is acquiring (critical
+ * sections, the DISPATCH gate), and xbox_SuspendGuestThread suspends a
+ * target only at a moment that count is zero: suspend, look, and if it is
+ * inside one, resume, yield and look again -- for up to
+ * RECOMP_SAFE_SUSPEND_MS (default 500), then suspend it where it is.
+ * RECOMP_SAFE_SUSPEND=0 suspends at once, as before. POSIX has no
+ * asynchronous suspend (SuspendThread only counts there), so this is
+ * Windows-only.
+ * ============================================================================ */
+
+#define XBOX_BUSY_SLOTS 1024
+
+static struct {
+    volatile LONG tid;
+    volatile LONG busy;
+} s_busy[XBOX_BUSY_SLOTS];
+static XBOX_THREAD_LOCAL volatile LONG *t_busy;
+
+static volatile LONG *busy_slot(DWORD tid, int create)
+{
+    unsigned i, h = (unsigned)tid * 2654435761u % XBOX_BUSY_SLOTS;
+
+    for (i = 0; i < XBOX_BUSY_SLOTS; i++) {
+        unsigned k = (h + i) % XBOX_BUSY_SLOTS;
+        LONG t = s_busy[k].tid;
+        if (t == (LONG)tid)
+            return &s_busy[k].busy;
+        if (t == 0) {
+            if (!create)
+                return NULL;
+            if (InterlockedCompareExchange(&s_busy[k].tid, (LONG)tid, 0) == 0) {
+                s_busy[k].busy = 0;
+                return &s_busy[k].busy;
+            }
+            if (s_busy[k].tid == (LONG)tid)
+                return &s_busy[k].busy;
+        }
+    }
+    return NULL;
+}
+
+void xbox_ThreadLockDepthAdd(long d)
+{
+    if (!t_busy)
+        t_busy = busy_slot(GetCurrentThreadId(), 1);
+    if (t_busy)
+        InterlockedExchangeAdd(t_busy, d);
+}
