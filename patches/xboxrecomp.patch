+    if (!_wcsicmp(p + n - 6, L"\\Cache"))
+        return 1;
+    tail = p + n - 14;   /* "Partition5.img" */
+    return !_wcsnicmp(tail, L"Partition", 9) && tail[9] >= L'3' && tail[9] <= L'5'
+        && !_wcsicmp(tail + 10, L".img");
