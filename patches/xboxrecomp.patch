+static int delete_tree_contents(const WCHAR *dir)
+{
+    WCHAR pat[MAX_PATH], sub[MAX_PATH];
+    WIN32_FIND_DATAW fd;
+    HANDLE h;
+    int n = 0;
+
+    swprintf_s(pat, MAX_PATH, L"%s\\*", dir);
+    h = FindFirstFileW(pat, &fd);
+    if (h == INVALID_HANDLE_VALUE)
+        return 0;
+    do {
+        if (!wcscmp(fd.cFileName, L".") || !wcscmp(fd.cFileName, L".."))
+            continue;
+        swprintf_s(sub, MAX_PATH, L"%s\\%s", dir, fd.cFileName);
+        if (fd.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) {
+            n += delete_tree_contents(sub);
+            RemoveDirectoryW(sub);
+        } else {
+            SetFileAttributesW(sub, FILE_ATTRIBUTE_NORMAL);
+            n += DeleteFileW(sub) ? 1 : 0;
+        }
+    } while (FindNextFileW(h, &fd));
+    FindClose(h);
+    return n;
+}
+
+/* The title formatted a cache partition (XMountUtilityDrive: XAPI dismounts
+ * the partition, FSCTL_DISMOUNT_VOLUME, and writes a fresh FATX volume when
+ * the cache database does not list the title as its owner -- here always,
+ * since nothing records an owner). A format empties the drive, and titles
+ * rely on that: RalliSport Challenge 2 rebuilds z:\<archive>.fa.cache every
+ * boot and renames it over z:\<archive>.fa with ReplaceIfExists = FALSE, which
+ * failed (STATUS_OBJECT_NAME_COLLISION) from the second run on and hung the
+ * boot. All cache partitions share <save_dir>\Cache, so empty that. */
+void xbox_path_format_cache(void)
+{
+    WCHAR dir[MAX_PATH];
+    int n;
+
+    swprintf_s(dir, MAX_PATH, L"%s\\Cache", s_save_dir);
+    n = delete_tree_contents(dir);
+    xbox_log(XBOX_LOG_INFO, XBOX_LOG_PATH,
+             "cache partition formatted by the title: removed %d file(s) from %ls", n, dir);
+}
+
