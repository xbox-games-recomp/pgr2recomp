+DWORD xbox_SuspendGuestThread(HANDLE h)
+{
+#ifdef _WIN32
+    static int on = -1;
+    static DWORD limit_ms;
+    static volatile LONG deferred, forced, clear;
+    DWORD tid = GetThreadId(h), prev, t0;
+    volatile LONG *busy;
+    int tries = 0;
+
+    if (on < 0) {
+        const char *e = getenv("RECOMP_SAFE_SUSPEND");
+        const char *m = getenv("RECOMP_SAFE_SUSPEND_MS");
+        limit_ms = (m && *m) ? (DWORD)strtoul(m, NULL, 0) : 500;
+        on = !(e && *e == '0');
+    }
+    if (!on || !tid || tid == GetCurrentThreadId() || !(busy = busy_slot(tid, 0)))
+        return SuspendThread(h);
+    t0 = GetTickCount();
+    for (;;) {
+        CONTEXT ctx;
+        prev = SuspendThread(h);
+        if (prev == (DWORD)-1 || prev > 0)
+            return prev;                /* failed, or already suspended */
+        /* SuspendThread is asynchronous; this returns once it has stopped. */
+        ctx.ContextFlags = CONTEXT_CONTROL;
+        GetThreadContext(h, &ctx);
+        if (*busy <= 0)
