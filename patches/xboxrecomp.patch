+    float r = mixbins[1][i] + mixbins[5][i] + mixbins[7][i] + mixbins[9][i];
+    for (int b = 11; b < NUM_MIXBINS; b++)
+        mono += c * mixbins[b][i];
+    *left = l + mono;
+    *right = r + mono;
