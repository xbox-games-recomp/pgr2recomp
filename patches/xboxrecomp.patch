+ * <save_dir>\Cache when opened as a directory (kernel_file.c). */
+static int bridge_is_cache_partition(HANDLE h)
+{
+    WCHAR p[MAX_PATH];
+    DWORD n = (h && h != INVALID_HANDLE_VALUE)
+        ? GetFinalPathNameByHandleW(h, p, MAX_PATH, FILE_NAME_NORMALIZED) : 0;
+    const WCHAR *tail;
+    if (!n || n >= MAX_PATH || n < 14)
