+/* An idle-voice trap (SE2FE_IDLE_VOICE) that the guest's service routine has
+ * not taken yet, for a voice the title has since unlinked from every voice
+ * list or started again: retract it -- FE back to free running, FETINTSTS
+ * down -- and return 1. The caller re-derives the line.
+ *
+ * On the console the routine runs at DIRQL microseconds after the trap,
+ * ahead of any thread at DISPATCH_LEVEL. Here it waits for the gate holder's
+ * next safe point, which can be the end of a long DirectSound region at
+ * raised IRQL: PGR2's (XDK DSOUND) Stop finds the FE already trapped, so it
+ * does not halt it, unlinks the voice itself (sub_001F25D7, no notification)
+ * and the release then nulls the voice's slot (sub_001EFFD5). The late
+ * routine looked the slot up, got null, and read 0xFFFFFFBE in
+ * sub_001F25D7; a slot already reused would have had a playing voice
+ * "completed" instead. A blank voice (voice_is_blank) is retracted too:
+ * the walk reached it through a block mid-rewrite. Retracting leaves what the console's order leaves:
+ * the voice off the list, the FE running. RECOMP_APU_STALE_TRAP=0 delivers
+ * such traps as before. */
+int mcpx_apu_vp_retract_stale_idle_trap(MCPXAPUState *d)
+{
+    static unsigned n;
+    static int tl = -1;
+    uint32_t fectl = d->regs[NV_PAPU_FECTL];
+    uint16_t v, h, prev = 0xFFFF;
+    int list, i, linked = 0, blank;
+
+    if (tl < 0)
+        tl = apu_env_on("RECOMP_APU_TRAPLOG");
+    if (!apu_stale_trap_on() || !(d->regs[NV_PAPU_ISTS] & NV_PAPU_ISTS_FETINTSTS) ||
+        (fectl & NV_PAPU_FECTL_FEMETHMODE) != NV_PAPU_FECTL_FEMETHMODE_TRAPPED ||
+        (fectl & NV_PAPU_FECTL_FETRAPREASON) != NV_PAPU_FECTL_FETRAPREASON_REQUESTED ||
+        d->regs[NV_PAPU_FEDECMETH] != SE2FE_IDLE_VOICE)
+        return 0;
+    v = (uint16_t)d->regs[NV_PAPU_FEDECPARAM];
+    for (list = 0; list < 3 && !linked; list++) {
+        h = (uint16_t)d->regs[voice_list_regs[list].top];
+        prev = 0xFFFF;
+        for (i = 0; h != 0xFFFF && i < MCPX_HW_MAX_VOICES; i++) {
+            if (h == v) { linked = 1; break; }
+            prev = h;
+            h = (uint16_t)voice_get_mask(d, h, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                                         NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE);
+        }
+    }
+    blank = voice_is_blank(d, v);
+    if (linked && !blank && !voice_get_mask(d, v, NV_PAVS_VOICE_PAR_STATE,
+                                            NV_PAVS_VOICE_PAR_STATE_ACTIVE_VOICE)) {
+        /* RECOMP_APU_TRAPLOG=1: every idle trap that goes to the routine
+         * (and every retraction below). */
+        if (tl)
+            fprintf(stderr, "[APU] idle trap to the routine: voice %u in list %d after %u, next %u\n", v,
+                    list - 1, prev,
+                    (unsigned)voice_get_mask(d, v, NV_PAVS_VOICE_TAR_PITCH_LINK,
+                                             NV_PAVS_VOICE_TAR_PITCH_LINK_NEXT_VOICE_HANDLE));
+        return 0;
+    }
+    d->regs[NV_PAPU_FECTL] &= ~(NV_PAPU_FECTL_FEMETHMODE | NV_PAPU_FECTL_FETRAPREASON);
+    qatomic_and(&d->regs[NV_PAPU_ISTS], ~NV_PAPU_ISTS_FETINTSTS);
+    if (n++ < 8 || tl)
+        fprintf(stderr, "[APU] stale idle-voice trap retracted: voice %u %s (%u so far)\n",
+                v, blank ? "blank" : linked ? "playing again" : "no longer in a list", n);
+    return 1;
+}
