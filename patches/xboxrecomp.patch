+                        "%lu ms (%d tries); suspended there\n", tid, limit_ms, tries);
+            return prev;
+        }
+        ResumeThread(h);
+        tries++;
+        Sleep(tries < 4 ? 0 : 1);
+    }
+    if (tries && InterlockedIncrement(&deferred) <= 8)
+        fprintf(stderr, "  [THREAD] NtSuspendThread: thread %lu was inside a guest lock; suspended "
+                "after it left (%d tries, %lu ms)\n", tid, tries, GetTickCount() - t0);
+    else if (!tries && InterlockedIncrement(&clear) <= 4)
+        fprintf(stderr, "  [THREAD] NtSuspendThread: thread %lu suspended outside any guest lock\n", tid);
+    return prev;
+#else
+    return SuspendThread(h);
+#endif
+}
