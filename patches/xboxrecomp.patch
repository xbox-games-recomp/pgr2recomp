+static int delete_tree_contents(const char *dir)
+{
+    DIR *d = opendir(dir);
+    struct dirent *e;
+    char sub[MAX_PATH];
+    struct stat st;
+    int n = 0;
+
+    if (!d)
+        return 0;
+    while ((e = readdir(d)) != NULL) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, ".."))
+            continue;
+        snprintf(sub, sizeof(sub), "%s/%s", dir, e->d_name);
+        if (lstat(sub, &st) == 0 && S_ISDIR(st.st_mode)) {
+            n += delete_tree_contents(sub);
+            rmdir(sub);
+        } else {
+            n += unlink(sub) == 0 ? 1 : 0;
+        }
+    }
+    closedir(d);
+    return n;
+}
+
+/* See the Win32 version. */
+void xbox_path_format_cache(void)
+{
+    char dir[MAX_PATH];
+    int n;
+
+    snprintf(dir, sizeof(dir), "%s/Cache", s_save_dir);
+    n = delete_tree_contents(dir);
+    xbox_log(XBOX_LOG_INFO, XBOX_LOG_PATH,
+             "cache partition formatted by the title: removed %d file(s) from %s", n, dir);
+}
+
 #endif /* _WIN32 */
